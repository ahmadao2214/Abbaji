---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
import SectionDivider from '../components/SectionDivider.astro';
---

<BaseLayout
  title="Legacy & Impact - Abdul Aziz Butt"
  description="The lasting legacy of Abdul Aziz Butt - founding father of University of Kashmir, educator of thousands, and inspiration for generations."
>
  <Hero
    variant="page"
    title="His Enduring Legacy"
    subtitle="Generations Transformed Through Education"
    quote="Sink your differences and Cement your relationships."
    quoteAuthor="Abdul Aziz Butt"
  />

  <!-- Educational Legacy -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-4xl font-serif font-bold text-kashmir-burgundy mb-12 text-center">
          Educational Impact
        </h2>

        <div class="mughal-grid-3 gap-8">
          <Card title="University of Kashmir" variant="bordered" showLeafWatermark={true}>
            <p class="mb-4">
              <strong>Founding faculty member (1948)</strong> - helped build the institution from the ground up,
              both physically and academically.
            </p>
            <p class="text-sm text-kashmir-lake-blue/70">
              Developed curriculum for Education department, trained countless teachers, shaped Kashmir's
              educational landscape for generations.
            </p>
          </Card>

          <Card title="Thousands of Students" variant="bordered" showLeafWatermark={true}>
            <p class="mb-4">
              As <strong>Professor, Dean, and Registrar</strong>, he directly influenced thousands of students
              over decades of teaching.
            </p>
            <p class="text-sm text-kashmir-lake-blue/70">
              His students became teachers, leaders, and changemakers throughout Kashmir and beyond.
            </p>
          </Card>

          <Card title="Social Work Pioneer" variant="bordered" showLeafWatermark={true}>
            <p class="mb-4">
              Pioneered <strong>social work education</strong> at the University of Kashmir, creating programs
              that continue today.
            </p>
            <p class="text-sm text-kashmir-lake-blue/70">
              Combined academic excellence with community service—education as transformation.
            </p>
          </Card>
        </div>

        <div class="mt-12 kashmir-card p-10 dal-lake-bg text-white text-center">
          <h3 class="text-3xl font-serif font-bold mb-4">From One Village to Thousands</h3>
          <p class="text-xl mb-4">
            He was one of only <strong>14 people from Bhalessa</strong> to become educated.
          </p>
          <p class="text-lg text-white/90">
            Through his work, he made higher education accessible to <strong>thousands of Kashmiris</strong>,
            breaking the cycle of illiteracy one student at a time.
          </p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider icon="leaf" />

  <!-- International Recognition -->
  <section class="section-padding bg-kashmir-cream">
    <div class="container-custom max-w-5xl mx-auto">
      <h2 class="text-4xl font-serif font-bold text-kashmir-burgundy mb-12 text-center">
        International Recognition
      </h2>

      <div class="mughal-grid gap-8">
        <Card title="Oxford University" variant="gradient">
          <p class="text-white/90 text-lg mb-3">Guest Lecturer</p>
          <p class="text-white/80">
            Brought Kashmiri perspectives and educational expertise to one of the world's most prestigious
            universities.
          </p>
        </Card>

        <Card title="Warwick University" variant="gradient">
          <p class="text-white/90 text-lg mb-3">Guest Lecturer</p>
          <p class="text-white/80">
            Shared decades of experience in education and social work with British academic community.
          </p>
        </Card>
      </div>

      <p class="text-center text-lg text-kashmir-lake-blue/80 mt-12 italic">
        "A self-taught scholar from a Kashmiri village stood as an equal among the world's finest academic minds."
      </p>
    </div>
  </section>

  <SectionDivider icon="shikara" />

  <!-- Family Legacy -->
  <section class="section-padding bg-white">
    <div class="container-custom max-w-5xl mx-auto">
      <h2 class="text-4xl font-serif font-bold text-kashmir-burgundy mb-12 text-center">
        Generational Legacy
      </h2>

      <div class="space-y-8">
        <Card title="His Children" variant="bordered">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <h4 class="font-semibold text-kashmir-burgundy mb-2">Sons:</h4>
              <ul class="space-y-2 text-sm">
                <li><strong>Altaf</strong> - Civil Engineer</li>
                <li><strong>Javaid</strong> - Pilot</li>
                <li><strong>Afzal</strong> - General Surgeon</li>
              </ul>
            </div>
            <div>
              <h4 class="font-semibold text-kashmir-burgundy mb-2">Daughters:</h4>
              <ul class="space-y-2 text-sm">
                <li><strong>Yasmeen</strong></li>
                <li><strong>Shaheen</strong></li>
                <li><strong>Masooda</strong> - Died as infant (1947)</li>
              </ul>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>

</BaseLayout>
