---
import BaseLayout from '../layouts/BaseLayout.astro';
import Prose from '../components/Prose.astro';
import { register } from '../data/register';
import { sourceById } from '../data/sources';
import { statusLabel } from '../data/status';
---

<BaseLayout
  title="The register · Abdul Aziz Butt"
  description="The hundred years of Abdul Aziz Butt, Abbaji, from Kilhotran in Bhalessa to Srinagar."
>
  <Prose>
    <h1 class="role-title">The register</h1>
    <p class="role-lede">From one village school to a life in education.</p>
    <p>
      Follow Abdul Aziz Butt’s hundred years, from a village school in Bhalessa to the university in Srinagar.
      Oxford is not in this list. No year has been found for it. The family remembers him as a travelling scholar
      there, and that memory is kept in <a href="/biography#kashmir">the life</a>.
    </p>
    <div class="reg">
      <div class="reg-head">
        <span>Years</span>
        <span>Post and place</span>
        <span>Source</span>
        <span>Status</span>
      </div>
      {
        register.map((entry) => {
          const source = sourceById(entry.sourceId);
          return (
            <article class="reg-row">
              <p class="reg-years">
                <span class="reg-label">Years</span>
                {entry.years}
              </p>
              <div>
                <p class="reg-title">{entry.title}</p>
                <p class="reg-text">{entry.text}</p>
              </div>
              <p>
                <span class="reg-label">Source</span>
                <a href={`/sources#${source.id}`}>{source.short}</a>
              </p>
              <p class="reg-status">
                <span class="reg-label">Status</span>
                {statusLabel[entry.status]}
              </p>
            </article>
          );
        })
      }
    </div>
    <p class="next-link"><a href="/sources">The sources, and what they do not show</a>.</p>
  </Prose>
</BaseLayout>
