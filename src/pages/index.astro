---
import BaseLayout from '../layouts/BaseLayout.astro';
import Prose from '../components/Prose.astro';
import Inscription from '../components/Inscription.astro';
import Memory from '../components/Memory.astro';
import { chapters } from '../data/chapters';
import { site } from '../data/site';
---

<BaseLayout
  title="Abdul Aziz Butt (1916–2016) · Abbaji"
  description="In memory of Abdul Aziz Butt, Abbaji (1916–2016), of Kilhotran in Bhalessa: teacher, headmaster, and professor and Registrar of the university in Srinagar."
  preloadUrdu={true}
>
  <Prose>
    <p class="role-kicker">Abbaji, to his family</p>
    <h1 class="role-name">{site.name}</h1>
    <p>
      <span class="urdu-name" lang="ur" dir="rtl">{site.urduName}</span>
    </p>
    <Inscription>{site.birth} – {site.death}</Inscription>
    <div class="prose-stack">
      <p>
        Abdul Aziz Butt, Abbaji to his family, was born on 26 July 1916 at Kilhotran, a village in Bhalessa.
        He lived to be a hundred, and gave most of those years to education. He was a professor at the
        university and served as its Registrar from September 1962 to 1971: Registrar of the University of
        Jammu and Kashmir and, after the university was divided in 1969, of the University of Kashmir. He
        died in Jammu on 7 August 2016, at the age of 100.
      </p>
      <Memory>
        <p>
          The family remembers this as his line.
          <q>{site.saying}</q>
        </p>
      </Memory>
    </div>
    <nav class="toc" aria-label="Chapters">
      <h2 class="toc-heading">The life</h2>
      {
        chapters.map((chapter) => (
          <a class="toc-line" href={`/biography#${chapter.id}`}>
            <span class="toc-years">{chapter.years}</span>
            <span class="toc-place">{chapter.place}</span>
          </a>
        ))
      }
    </nav>
    <p class="next-link">
      <a href="/sources">How this account is sourced</a>.
    </p>
  </Prose>
</BaseLayout>
