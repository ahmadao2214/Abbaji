---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
import SectionDivider from '../components/SectionDivider.astro';
import KashidaBorder from '../components/KashidaBorder.astro';
import ChinaLeaf from '../components/ChinaLeaf.astro';
---

<BaseLayout
  title="Family - Abdul Aziz Bhat"
  description="The family of Abdul Aziz Bhat - six children, grandchildren across the globe, and a legacy spanning three generations."
>
  <Hero
    variant="page"
    title="Family Tree"
    subtitle="Three Generations of Excellence"
    quote="Like branches of a chinar tree, his legacy grows and spreads across the world."
  />

  <!-- Abbaji & Saideh -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-serif font-bold text-kashmir-burgundy mb-4">
            Abdul Aziz & Saideh Bhat
          </h2>
          <p class="text-xl text-kashmir-lake-blue/80">
            A partnership that weathered unimaginable storms and built an extraordinary legacy
          </p>
        </div>

        <div class="kashmir-card p-10 dal-lake-bg text-white">
          <div class="max-w-3xl mx-auto">
            <p class="text-lg mb-6">
              <strong>Saideh Bhat</strong> survived the 1947 Jammu Massacre with her husband, despite
              suffering a head injury. Together, they raised six children and witnessed the growth of
              a family that would span continents and professions.
            </p>
            <p class="text-lg text-white/90">
              Their marriage was marked by resilience—losing their infant daughter Masooda in 1947,
              yet moving forward to build a life of meaning, service, and family.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider icon="leaf" />

  <!-- The Six Children -->
  <section class="section-padding bg-kashmir-cream">
    <div class="container-custom">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <div class="flex justify-center mb-6">
            <ChinaLeaf size="lg" color="burgundy" />
          </div>
          <h2 class="text-4xl font-serif font-bold text-kashmir-burgundy mb-4">
            His Children
          </h2>
          <p class="text-xl text-kashmir-lake-blue/80">
            Six remarkable individuals continuing his tradition of excellence
          </p>
        </div>

        <KashidaBorder variant="floral" height="60px" class="mb-12 opacity-40" />

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <Card title="Masooda Bhat" variant="bordered" showLeafWatermark={true}>
            <p class="text-sm text-kashmir-lake-blue/70 mb-3">
              <strong>Daughter (First child)</strong>
            </p>
            <p class="text-base mb-4">
              Died as an infant during the 1947 Jammu Massacre. Shot while being held by her father.
              Her tragic death marked one of the darkest moments in the family's history.
            </p>
            <p class="text-sm italic text-kashmir-burgundy">
              Forever remembered, forever mourned.
            </p>
          </Card>

          <Card title="Yasmeen" variant="bordered" showLeafWatermark={true}>
            <p class="text-sm text-kashmir-lake-blue/70 mb-3">
              <strong>Daughter</strong>
            </p>
            <p class="text-base">
              One of Abdul Aziz and Saideh's daughters, part of the family that survived and rebuilt
              after 1947.
            </p>
          </Card>

          <Card title="Altaf Bhat" variant="bordered" showLeafWatermark={true}>
            <p class="text-sm text-kashmir-lake-blue/70 mb-3">
              <strong>Son - Civil Engineer</strong>
            </p>
            <p class="text-base">
              Following his father's example of building and creating, Altaf became a <strong>Civil Engineer</strong>,
              literally building infrastructure as his father built educational institutions.
            </p>
          </Card>

          <Card title="Javaid Bhat" variant="bordered" showLeafWatermark={true}>
            <p class="text-sm text-kashmir-lake-blue/70 mb-3">
              <strong>Son - Pilot</strong>
            </p>
            <p class="text-base">
              Javaid took to the skies as a <strong>Pilot</strong>, navigating aircraft as his father
              navigated the complexities of education and institution-building.
            </p>
          </Card>

          <Card title="Shaheen" variant="bordered" showLeafWatermark={true}>
            <p class="text-sm text-kashmir-lake-blue/70 mb-3">
              <strong>Daughter</strong>
            </p>
            <p class="text-base">
              One of Abdul Aziz and Saideh's daughters, carrying forward the family values and legacy.
            </p>
          </Card>

          <Card title="Afzal Bhat" variant="bordered" showLeafWatermark={true}>
            <p class="text-sm text-kashmir-lake-blue/70 mb-3">
              <strong>Son (Born 1955) - Surgical Assistant</strong>
            </p>
            <p class="text-base">
              The youngest of the six children, Afzal pursued a career in healthcare as a
              <strong>Surgical Assistant</strong>, serving others through medicine.
            </p>
          </Card>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider icon="shikara" />

  <!-- Grandchildren -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-serif font-bold text-kashmir-burgundy mb-4">
            Grandchildren - Global Impact
          </h2>
          <p class="text-xl text-kashmir-lake-blue/80 max-w-3xl mx-auto">
            From Balesa village to Silicon Valley, London, and beyond—the third generation
            carries Abbaji's legacy worldwide
          </p>
        </div>

        <KashidaBorder variant="geometric" height="60px" class="mb-12 opacity-40" />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          <Card title="Azhar" variant="gradient">
            <p class="text-white/90 text-lg mb-3">
              <strong>Senior Software Engineer - Riot Games</strong>
            </p>
            <p class="text-white/80 mb-4">
              Building the technology that entertains millions globally. From Kashmir's educational
              foundations to Silicon Valley innovation.
            </p>
            <p class="text-sm text-white/70 italic">
              The creator of this memorial website—honoring Abbaji's legacy through technology.
            </p>
          </Card>

          <Card title="Shiraz" variant="gradient">
            <p class="text-white/90 text-lg mb-3">
              <strong>Director - PwC</strong>
            </p>
            <p class="text-white/80">
              Leading at one of the world's largest professional services firms, bringing strategic
              vision and excellence to global business.
            </p>
          </Card>

          <Card title="Shabaz" variant="gradient">
            <p class="text-white/90 text-lg mb-3">
              <strong>Director - Kimberly-Clark</strong>
            </p>
            <p class="text-white/80">
              Executive leadership at a Fortune 500 company, managing global operations and
              strategic initiatives.
            </p>
          </Card>

          <Card title="Sanah" variant="gradient">
            <p class="text-white/90 text-lg mb-3">
              <strong>Beauty Education</strong>
            </p>
            <p class="text-white/80">
              Continuing the family tradition of education and service, teaching and empowering
              others in the beauty industry.
            </p>
          </Card>
        </div>

        <div class="kashmir-card p-10 border-l-8 border-kashmir-burgundy bg-kashmir-cream">
          <h3 class="text-2xl font-serif font-bold text-kashmir-burgundy mb-4">
            More Grandchildren & Great-Grandchildren
          </h3>
          <p class="text-lg text-kashmir-lake-blue/90 mb-4">
            Abdul Aziz Bhat's family tree has many more branches—grandchildren and great-grandchildren
            carrying forward his values of education, service, and excellence around the world.
          </p>
          <p class="text-base text-kashmir-lake-blue/70 italic">
            <strong>Note:</strong> This page will be updated with additional family members as information
            and photos become available. If you're a family member, please reach out to add your story!
          </p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider icon="leaf" />

  <!-- Family Values -->
  <section class="section-padding bg-gradient-to-b from-kashmir-cream to-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-serif font-bold text-kashmir-burgundy mb-4">
            Family Values & Legacy
          </h2>
          <p class="text-xl text-kashmir-lake-blue/80">
            The principles that bind three generations
          </p>
        </div>

        <div class="space-y-6">
          <div class="kashmir-card p-8 border-l-8 border-kashmir-gold">
            <h4 class="text-xl font-serif font-bold text-kashmir-burgundy mb-3">Education</h4>
            <p class="text-kashmir-lake-blue/90">
              From self-taught scholar to professors, engineers, pilots, directors—education remains
              the foundation. Every generation reaches higher.
            </p>
          </div>

          <div class="kashmir-card p-8 border-l-8 border-kashmir-royal-blue">
            <h4 class="text-xl font-serif font-bold text-kashmir-burgundy mb-3">Resilience</h4>
            <p class="text-kashmir-lake-blue/90">
              Surviving tragedy, rebuilding from loss, persevering through challenges—the family
              has demonstrated resilience across three generations.
            </p>
          </div>

          <div class="kashmir-card p-8 border-l-8 border-kashmir-forest-green">
            <h4 class="text-xl font-serif font-bold text-kashmir-burgundy mb-3">Global Citizenship</h4>
            <p class="text-kashmir-lake-blue/90">
              From Balesa to Britain, California to corporate boardrooms worldwide—the family has
              embraced global opportunities while honoring their Kashmir roots.
            </p>
          </div>

          <div class="kashmir-card p-8 border-l-8 border-kashmir-burgundy">
            <h4 class="text-xl font-serif font-bold text-kashmir-burgundy mb-3">Service</h4>
            <p class="text-kashmir-lake-blue/90">
              Whether through education, healthcare, technology, or business—every generation serves
              others and contributes to their communities.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider icon="shikara" />

  <!-- Family Tree Visual -->
  <section class="section-padding-sm bg-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <h3 class="text-3xl font-serif font-bold text-kashmir-burgundy mb-8">
          Three Generations
        </h3>

        <div class="kashmir-card p-12 bg-gradient-to-br from-kashmir-burgundy to-kashmir-crimson text-white">
          <div class="space-y-8">
            <div>
              <p class="text-sm uppercase tracking-wide text-kashmir-gold mb-2">First Generation</p>
              <p class="text-2xl font-serif font-bold">Abdul Aziz & Saideh Bhat</p>
              <p class="text-white/80 text-sm mt-2">Balesa, Kashmir • 1916-2016</p>
            </div>

            <div class="h-px bg-kashmir-gold/30"></div>

            <div>
              <p class="text-sm uppercase tracking-wide text-kashmir-gold mb-2">Second Generation</p>
              <p class="text-xl font-serif font-bold">Six Children</p>
              <p class="text-white/90 text-sm mt-2">
                Engineers • Pilots • Healthcare Professionals
              </p>
            </div>

            <div class="h-px bg-kashmir-gold/30"></div>

            <div>
              <p class="text-sm uppercase tracking-wide text-kashmir-gold mb-2">Third Generation</p>
              <p class="text-xl font-serif font-bold">Grandchildren & Great-Grandchildren</p>
              <p class="text-white/90 text-sm mt-2">
                Tech Leaders • Corporate Directors • Educators • And More
              </p>
            </div>
          </div>

          <div class="flex justify-center space-x-4 mt-10">
            <ChinaLeaf size="md" color="gold" />
            <ChinaLeaf size="md" color="crimson" />
            <ChinaLeaf size="md" color="gold" />
          </div>
        </div>

        <p class="text-lg text-kashmir-lake-blue/80 mt-12 italic">
          "A family tree rooted in Kashmir, with branches reaching across the world"
        </p>

        <div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/biography" class="btn-primary inline-block no-underline">
            Read His Biography
          </a>
          <a href="/legacy" class="btn-secondary inline-block no-underline">
            Explore His Legacy
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
