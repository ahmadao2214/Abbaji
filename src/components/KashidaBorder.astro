---
interface Props {
  class?: string;
  variant?: 'floral' | 'vine' | 'geometric';
  height?: string;
}

const {
  class: className = '',
  variant = 'floral',
  height = '60px',
} = Astro.props;
---

<div class:list={['kashida-border', className]} style={`height: ${height}`}>
  {variant === 'floral' && (
    <svg width="100%" height="100%" preserveAspectRatio="none" viewBox="0 0 1200 60" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="kashida-floral" x="0" y="0" width="120" height="60" patternUnits="userSpaceOnUse">
          <!-- Floral motif -->
          <circle cx="30" cy="30" r="4" fill="#8B2635" />
          <circle cx="60" cy="30" r="6" fill="#D4AF37" />
          <circle cx="90" cy="30" r="4" fill="#8B2635" />

          <!-- Petals around center flower -->
          <ellipse cx="60" cy="20" rx="3" ry="6" fill="#A52A2A" />
          <ellipse cx="60" cy="40" rx="3" ry="6" fill="#A52A2A" />
          <ellipse cx="50" cy="30" rx="6" ry="3" fill="#A52A2A" />
          <ellipse cx="70" cy="30" rx="6" ry="3" fill="#A52A2A" />

          <!-- Connecting vines -->
          <path d="M 15 30 Q 22 25 30 30 Q 38 35 45 30"
                stroke="#2C5530"
                stroke-width="1.5"
                fill="none"
                opacity="0.6" />
          <path d="M 75 30 Q 82 25 90 30 Q 98 35 105 30"
                stroke="#2C5530"
                stroke-width="1.5"
                fill="none"
                opacity="0.6" />

          <!-- Small leaves -->
          <ellipse cx="22" cy="28" rx="2" ry="4" fill="#50C878" opacity="0.7" transform="rotate(-30 22 28)" />
          <ellipse cx="98" cy="28" rx="2" ry="4" fill="#50C878" opacity="0.7" transform="rotate(30 98 28)" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#kashida-floral)" />
    </svg>
  )}

  {variant === 'vine' && (
    <svg width="100%" height="100%" preserveAspectRatio="none" viewBox="0 0 1200 60" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="kashida-vine" x="0" y="0" width="100" height="60" patternUnits="userSpaceOnUse">
          <!-- Vine path -->
          <path d="M 0 30 Q 15 20 25 30 Q 35 40 50 30 Q 65 20 75 30 Q 85 40 100 30"
                stroke="#8B2635"
                stroke-width="2"
                fill="none" />

          <!-- Leaves along vine -->
          <ellipse cx="15" cy="25" rx="4" ry="6" fill="#2C5530" opacity="0.8" />
          <ellipse cx="40" cy="35" rx="4" ry="6" fill="#2C5530" opacity="0.8" />
          <ellipse cx="60" cy="25" rx="4" ry="6" fill="#2C5530" opacity="0.8" />
          <ellipse cx="85" cy="35" rx="4" ry="6" fill="#2C5530" opacity="0.8" />

          <!-- Small flowers -->
          <circle cx="25" cy="30" r="3" fill="#D4AF37" />
          <circle cx="75" cy="30" r="3" fill="#D4AF37" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#kashida-vine)" />
    </svg>
  )}

  {variant === 'geometric' && (
    <svg width="100%" height="100%" preserveAspectRatio="none" viewBox="0 0 1200 60" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="kashida-geometric" x="0" y="0" width="80" height="60" patternUnits="userSpaceOnUse">
          <!-- Diamond shape -->
          <path d="M 40 10 L 50 30 L 40 50 L 30 30 Z"
                fill="none"
                stroke="#8B2635"
                stroke-width="2" />

          <!-- Inner square -->
          <rect x="35" y="25" width="10" height="10"
                fill="#D4AF37"
                opacity="0.6"
                transform="rotate(45 40 30)" />

          <!-- Decorative dots -->
          <circle cx="20" cy="30" r="2" fill="#4169E1" />
          <circle cx="60" cy="30" r="2" fill="#4169E1" />

          <!-- Corner flourishes -->
          <path d="M 15 30 L 20 30" stroke="#2C5530" stroke-width="1.5" />
          <path d="M 60 30 L 65 30" stroke="#2C5530" stroke-width="1.5" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#kashida-geometric)" />
    </svg>
  )}
</div>

<style>
  .kashida-border {
    width: 100%;
    display: block;
  }
</style>
