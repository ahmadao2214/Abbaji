---
import { statusLabel, type Status } from '../data/status';

interface Props {
  n: number;
  status: Status;
}

const { n, status } = Astro.props;
---

<li class="endnote" id={`note-${n}`} data-status={status}>
  <p>
    <span class="endnote-num">{n}.</span>
    <span class="label">{statusLabel[status]}</span>
    <slot />
  </p>
</li>
