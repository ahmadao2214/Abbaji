---
import { nav, site } from '../data/site';
---

<footer class="site-footer">
  <div class="sheet footer-bar">
    <p>{site.name}, {site.nickname}, 1916–2016.</p>
    <p>
      Teacher, headmaster, college principal, and professor and Registrar of the university in Srinagar.
      From Kilhotran in Bhalessa.
    </p>
    <p>
      Kept by his family. Revised {site.revision}.
      <a href="/sources">How this site is sourced</a>.
    </p>
    <nav aria-label="Footer">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>
