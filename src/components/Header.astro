---
import KashidaBorder from './KashidaBorder.astro';
import ChinaLeaf from './ChinaLeaf.astro';

const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/biography', label: 'Biography' },
  { href: '/legacy', label: 'Legacy' },
  { href: '/timeline', label: 'Timeline' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/family', label: 'Family' },
];
---

<header class="sticky top-0 z-50 bg-kashmir-cream/95 backdrop-blur-sm shadow-md">
  <div class="container-custom">
    <!-- Top decorative border -->
    <div class="h-1 bg-gradient-to-r from-kashmir-burgundy via-kashmir-gold to-kashmir-burgundy"></div>

    <nav class="py-4" aria-label="Main navigation">
      <div class="flex items-center justify-between">
        <!-- Logo/Brand -->
        <a href="/" class="flex items-center space-x-3 no-underline group">
          <ChinaLeaf size="md" color="burgundy" class="group-hover:rotate-12 transition-transform" />
          <div>
            <h1 class="text-xl md:text-2xl font-serif font-bold text-kashmir-burgundy mb-0">
              Abdul Aziz Bhat
            </h1>
            <p class="text-xs md:text-sm text-kashmir-lake-blue/70 italic">
              1916-2016 • عبدالعزیز بھٹ
            </p>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <ul class="hidden lg:flex items-center space-x-8">
          {navItems.map(item => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'nav-link text-base font-medium transition-all duration-300 no-underline',
                  currentPath === item.href
                    ? 'text-kashmir-burgundy font-semibold'
                    : 'text-kashmir-lake-blue hover:text-kashmir-burgundy'
                ]}
                aria-current={currentPath === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-button"
          class="lg:hidden p-2 rounded-md text-kashmir-burgundy hover:bg-kashmir-burgundy/10 transition-colors"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle mobile menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

      <!-- Mobile Navigation -->
      <div
        id="mobile-menu"
        class="hidden lg:hidden mt-4 pb-4 border-t-2 border-kashmir-gold/30 pt-4"
      >
        <ul class="space-y-3">
          {navItems.map(item => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'block py-2 px-4 rounded-md transition-all duration-300 no-underline',
                  currentPath === item.href
                    ? 'bg-kashmir-burgundy text-kashmir-cream font-semibold'
                    : 'text-kashmir-lake-blue hover:bg-kashmir-burgundy/10 hover:text-kashmir-burgundy'
                ]}
                aria-current={currentPath === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  </div>

  <!-- Bottom decorative border -->
  <KashidaBorder variant="vine" height="40px" class="opacity-40" />
</header>

<style>
  .nav-link {
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--kashmir-burgundy), var(--kashmir-gold));
    transition: width 0.3s ease;
  }

  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    width: 100%;
  }
</style>
